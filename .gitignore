# Build output (also holds the development database, target/dev.sqlite)
/target

# Local databases and backups
*.sqlite
*.sqlite-journal

# Editor and OS files
.vscode/
.idea/
.DS_Store

# Web build output
/crates/app/dist

# Desktop packages (scripts/package.sh)
/dist-desktop

# The update signing tool's build output
/tools/sign-update/target

# Secrets that must never be committed: signing keys, the sync server's
# local Worker secrets
*.key
server/.dev.vars

# Python caches
__pycache__/
