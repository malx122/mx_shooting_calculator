{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MX Shooting Calculator export",
  "description": "A file of the hunter's own records: an export, a backup or a sync copy.",
  "type": "object",
  "properties": {
    "format": {
      "description": "Always `mxsc/personal-data`. Files from the app's earlier names say\n`mhc/personal-data` or `ballistic-calculator/personal-data`.",
      "type": "string"
    },
    "version": {
      "description": "The format's version; this description is of version 5. A reader\nshould refuse versions newer than it knows.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "exported_at": {
      "description": "When the file was written, in milliseconds since 1970 (UTC).",
      "type": "integer",
      "format": "int64"
    },
    "rifles": {
      "description": "The hunter's rifles.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Rifle"
      }
    },
    "bullets": {
      "description": "The hunter's bullets: factory ammunition and handloads.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Bullet"
      }
    },
    "rifle_loads": {
      "description": "What is particular to a bullet in a rifle: measured velocities,\npoint of impact, zero weather and truing.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/RifleLoad"
      }
    },
    "scopes": {
      "description": "Scopes the hunter entered (catalog scopes are only named by id).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/UserScope"
      },
      "default": []
    },
    "targets": {
      "description": "Targets the hunter made or copied (catalog targets aren't included).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Target"
      },
      "default": []
    },
    "deleted": {
      "description": "Records deleted, so merging the file deletes them elsewhere too.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Deletion"
      },
      "default": []
    },
    "catalog": {
      "description": "The catalog entries the records refer to by id, written out so the\nfile can be read without the app. Only in exported files; importing\nignores it.",
      "$ref": "#/$defs/CatalogDetails"
    }
  },
  "required": [
    "format",
    "version",
    "exported_at",
    "rifles",
    "bullets",
    "rifle_loads",
    "scopes",
    "targets",
    "deleted"
  ],
  "$defs": {
    "Rifle": {
      "description": "A rifle: its caliber, barrel, scope and zero.",
      "type": "object",
      "properties": {
        "id": {
          "description": "The rifle's id, unique among rifles.",
          "type": "string"
        },
        "name": {
          "description": "The hunter's name for the rifle.",
          "type": "string"
        },
        "caliber": {
          "description": "The caliber's key in the app's catalog, e.g. `6-5x55-se` (see\n`catalog`).",
          "type": "string"
        },
        "barrel_length_mm": {
          "description": "Barrel length; `null` when not known.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "twist_in": {
          "description": "Barrel length for one turn of the rifling, in inches.",
          "type": "number",
          "format": "double"
        },
        "right_hand_twist": {
          "description": "Whether the rifling turns to the right (clockwise seen from behind), as\nmost do.",
          "type": "boolean"
        },
        "sight_height_cm": {
          "description": "Height of the scope's axis above the bore's axis.",
          "type": "number",
          "format": "double"
        },
        "zero_range_m": {
          "description": "The range the rifle is zeroed at.",
          "type": "number",
          "format": "double"
        },
        "zero_height_cm": {
          "description": "Where the zero puts the bullet at the zero range: above (positive)\nor below the line of sight, cm. Hunters often zero \"4 cm high at\n100 m\"; zero for a plain zero.",
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "zero_temperature_c": {
          "description": "Air temperature when the rifle was zeroed.",
          "type": "number",
          "format": "double"
        },
        "zero_pressure_hpa": {
          "description": "Air pressure when the rifle was zeroed, as a barometer at the range\nreads it (not reduced to sea level).",
          "type": "number",
          "format": "double"
        },
        "zero_powder_temperature_c": {
          "description": "Powder temperature at the zero; `None` means the air temperature.",
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "default": null
        },
        "zero_humidity_percent": {
          "description": "Relative humidity when the rifle was zeroed.",
          "type": "number",
          "format": "double",
          "default": 50.0
        },
        "table": {
          "description": "The range table's ranges and columns.",
          "$ref": "#/$defs/TableSettings",
          "default": {
            "start_m": 0.0,
            "end_m": 400.0,
            "step_m": 50.0,
            "columns": {
              "drop_length": false,
              "drop_mil": true,
              "drop_moa": false,
              "drop_clicks": true,
              "wind_length": false,
              "wind_mil": true,
              "wind_moa": false,
              "wind_clicks": false,
              "velocity": false,
              "energy": true,
              "time": false
            }
          }
        },
        "click_unit": {
          "description": "The unit of the scope's clicks.",
          "$ref": "#/$defs/ClickUnit"
        },
        "click_value": {
          "description": "One click of the turrets, in `click_unit`: 0.1 for 0.1 mil, 0.25 for 1/4\nMOA.",
          "type": "number",
          "format": "double"
        },
        "scope_id": {
          "description": "The mounted scope: the id of one of the file's `scopes`, or of a\nscope in the app's catalog (see `catalog`); `null` for none.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "reticle_id": {
          "description": "The scope's reticle: the id of a reticle in the app's catalog.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "notes": {
          "description": "The hunter's notes.",
          "type": "string"
        },
        "updated_at": {
          "description": "When the record was last changed, in milliseconds since 1970 (UTC).\nMerging keeps the copy changed last.",
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "id",
        "name",
        "caliber",
        "barrel_length_mm",
        "twist_in",
        "right_hand_twist",
        "sight_height_cm",
        "zero_range_m",
        "zero_height_cm",
        "zero_temperature_c",
        "zero_pressure_hpa",
        "zero_powder_temperature_c",
        "zero_humidity_percent",
        "table",
        "click_unit",
        "click_value",
        "scope_id",
        "reticle_id",
        "notes",
        "updated_at"
      ]
    },
    "TableSettings": {
      "description": "The rifle's range table: which ranges and which columns.",
      "type": "object",
      "properties": {
        "start_m": {
          "description": "The first range.",
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "end_m": {
          "description": "The last range.",
          "type": "number",
          "format": "double",
          "default": 400.0
        },
        "step_m": {
          "description": "The distance between ranges.",
          "type": "number",
          "format": "double",
          "default": 50.0
        },
        "columns": {
          "description": "Which columns to show.",
          "$ref": "#/$defs/TableColumns",
          "default": {
            "drop_length": false,
            "drop_mil": true,
            "drop_moa": false,
            "drop_clicks": true,
            "wind_length": false,
            "wind_mil": true,
            "wind_moa": false,
            "wind_clicks": false,
            "velocity": false,
            "energy": true,
            "time": false
          }
        }
      },
      "required": [
        "start_m",
        "end_m",
        "step_m",
        "columns"
      ]
    },
    "TableColumns": {
      "description": "Which range table columns to show besides the range. Elevation and\nwind are corrections: what to dial or hold, up and right positive.",
      "type": "object",
      "properties": {
        "drop_length": {
          "description": "Where a dead-on hold hits, above (+) or below the aim, as a length.",
          "type": "boolean",
          "default": false
        },
        "drop_mil": {
          "description": "Elevation in mil.",
          "type": "boolean",
          "default": true
        },
        "drop_moa": {
          "description": "Elevation in MOA.",
          "type": "boolean",
          "default": false
        },
        "drop_clicks": {
          "description": "Elevation in the rifle's clicks.",
          "type": "boolean",
          "default": true
        },
        "wind_length": {
          "description": "Wind drift as a length.",
          "type": "boolean",
          "default": false
        },
        "wind_mil": {
          "description": "Wind correction in mil.",
          "type": "boolean",
          "default": true
        },
        "wind_moa": {
          "description": "Wind correction in MOA.",
          "type": "boolean",
          "default": false
        },
        "wind_clicks": {
          "description": "Wind correction in clicks.",
          "type": "boolean",
          "default": false
        },
        "velocity": {
          "description": "The bullet's speed.",
          "type": "boolean",
          "default": false
        },
        "energy": {
          "description": "The bullet's energy.",
          "type": "boolean",
          "default": true
        },
        "time": {
          "description": "Time of flight.",
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "drop_length",
        "drop_mil",
        "drop_moa",
        "drop_clicks",
        "wind_length",
        "wind_mil",
        "wind_moa",
        "wind_clicks",
        "velocity",
        "energy",
        "time"
      ]
    },
    "ClickUnit": {
      "description": "The unit of a scope's clicks as the rifle stores it.",
      "type": "string",
      "enum": [
        "mil",
        "moa"
      ]
    },
    "Bullet": {
      "description": "A bullet in the hunter's own collection: either factory ammunition or a\nhandload. Only these can be chosen when calculating.",
      "type": "object",
      "properties": {
        "id": {
          "description": "The bullet's id, unique among bullets.",
          "type": "string"
        },
        "kind": {
          "description": "Factory ammunition or a handload.",
          "$ref": "#/$defs/BulletKind"
        },
        "manufacturer": {
          "description": "The maker, e.g. `Federal`.",
          "type": "string"
        },
        "name": {
          "description": "The product, e.g. `Terminal Ascent`.",
          "type": "string"
        },
        "caliber": {
          "description": "Caliber key of the cartridge this is loaded in.",
          "type": "string"
        },
        "diameter_mm": {
          "description": "Bullet diameter.",
          "type": "number",
          "format": "double"
        },
        "mass_g": {
          "description": "Bullet weight in grams (7000 grains a pound: 1 gr = 0.0648 g).",
          "type": "number",
          "format": "double"
        },
        "length_mm": {
          "description": "Bullet length, for stability, spin drift and aerodynamic jump; `null`\nwhen not known.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "bc_g1": {
          "description": "G1 ballistic coefficient (lb/in²), if known.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "bc_g7": {
          "description": "G7 ballistic coefficient (lb/in²), if known.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "drag_model": {
          "description": "Which of the two BCs the calculation uses.",
          "$ref": "#/$defs/BcModel"
        },
        "bc_bands": {
          "description": "BCs for velocity bands under `drag_model`; when present they replace\nthe single BC in the calculation.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/BcBand"
          },
          "default": []
        },
        "drag_curve": {
          "description": "Drag coefficient by Mach number, used when `drag_model` is `Custom`.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/DragPoint"
          },
          "default": []
        },
        "muzzle_velocity_mps": {
          "description": "Muzzle velocity: the maker's for factory ammunition, the hunter's for a\nhandload.",
          "type": "number",
          "format": "double"
        },
        "velocity_temperature_c": {
          "description": "Temperature the muzzle velocity was measured at.",
          "type": "number",
          "format": "double"
        },
        "velocity_per_degree": {
          "description": "Change in muzzle velocity per °C of powder temperature, in m/s.",
          "type": "number",
          "format": "double"
        },
        "test_barrel_mm": {
          "description": "Length of the barrel the maker's velocity was measured in, if known.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "construction": {
          "description": "How the bullet is made.",
          "$ref": "#/$defs/Construction"
        },
        "lead_free": {
          "description": "Whether the bullet is lead-free.",
          "type": "boolean"
        },
        "min_expansion_mps": {
          "description": "The least impact speed at which it expands, as the maker gives it.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "catalog_id": {
          "description": "The catalog entry this was copied from, if any.",
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "description": "The hunter's notes.",
          "type": "string"
        },
        "updated_at": {
          "description": "When the record was last changed, in milliseconds since 1970 (UTC).\nMerging keeps the copy changed last.",
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "id",
        "kind",
        "manufacturer",
        "name",
        "caliber",
        "diameter_mm",
        "mass_g",
        "length_mm",
        "bc_g1",
        "bc_g7",
        "drag_model",
        "bc_bands",
        "drag_curve",
        "muzzle_velocity_mps",
        "velocity_temperature_c",
        "velocity_per_degree",
        "test_barrel_mm",
        "construction",
        "lead_free",
        "min_expansion_mps",
        "catalog_id",
        "notes",
        "updated_at"
      ]
    },
    "BulletKind": {
      "description": "Factory ammunition or the hunter's own load.",
      "oneOf": [
        {
          "description": "Factory-loaded cartridge: the velocity comes from the box.",
          "type": "string",
          "const": "factory"
        },
        {
          "description": "A component bullet loaded by the hunter: the velocity is their own.",
          "type": "string",
          "const": "handload"
        }
      ]
    },
    "BcModel": {
      "description": "How the bullet's drag is described.",
      "oneOf": [
        {
          "description": "A G1 ballistic coefficient (`bc_g1`).",
          "type": "string",
          "const": "G1"
        },
        {
          "description": "A G7 ballistic coefficient (`bc_g7`).",
          "type": "string",
          "const": "G7"
        },
        {
          "description": "The bullet's own drag curve (`drag_curve`) instead of a BC.",
          "type": "string",
          "const": "Custom"
        }
      ]
    },
    "BcBand": {
      "description": "One BC band: the BC that applies at a velocity.",
      "type": "object",
      "properties": {
        "velocity_mps": {
          "description": "From this speed down to the next band's.",
          "type": "number",
          "format": "double"
        },
        "bc": {
          "description": "The BC (of the bullet's `drag_model`) at that speed.",
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "velocity_mps",
        "bc"
      ]
    },
    "DragPoint": {
      "description": "One point of a bullet's own drag curve.",
      "type": "object",
      "properties": {
        "mach": {
          "description": "Speed as a Mach number.",
          "type": "number",
          "format": "double"
        },
        "cd": {
          "description": "Drag coefficient at that speed.",
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "mach",
        "cd"
      ]
    },
    "Construction": {
      "description": "How the bullet is made, which decides whether it expands (and so its\nlegal class for game): `fmj` and `match` don't, `other` is unknown, and\nthe rest do.",
      "type": "string",
      "enum": [
        "cup_and_core",
        "bonded",
        "partition",
        "monolithic",
        "polymer_tip",
        "polymer_tip_bonded",
        "polymer_tip_monolithic",
        "fmj",
        "match",
        "other"
      ]
    },
    "RifleLoad": {
      "description": "A bullet as shot from one particular rifle: chronographed velocities,\nwhere it hits relative to the rifle's zero, and the weather it was zeroed\nin. Everything here overrides the bullet's general data for this rifle.",
      "type": "object",
      "properties": {
        "id": {
          "description": "The load's id, unique among loads.",
          "type": "string"
        },
        "rifle_id": {
          "description": "The rifle (one of the file's `rifles`).",
          "type": "string"
        },
        "bullet_id": {
          "description": "The bullet (one of the file's `bullets`).",
          "type": "string"
        },
        "velocities": {
          "description": "Measured velocities; empty means the bullet's own velocity is used.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/VelocityPoint"
          },
          "default": []
        },
        "impact_offset_mrad": {
          "description": "Where this load hits relative to the rifle's zero, as an angle in\nmrad: [right, up].",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "minItems": 2,
          "maxItems": 2,
          "default": [
            0.0,
            0.0
          ]
        },
        "zero": {
          "description": "Which weather this load's zero was made in.",
          "$ref": "#/$defs/LoadZero",
          "default": {
            "mode": "rifle"
          }
        },
        "truing": {
          "description": "A long shot the calculation was trued to, if any.",
          "anyOf": [
            {
              "$ref": "#/$defs/Truing"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "description": "The hunter's notes.",
          "type": "string"
        },
        "updated_at": {
          "description": "When the record was last changed, in milliseconds since 1970 (UTC).\nMerging keeps the copy changed last.",
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "id",
        "rifle_id",
        "bullet_id",
        "velocities",
        "impact_offset_mrad",
        "zero",
        "notes",
        "updated_at"
      ]
    },
    "VelocityPoint": {
      "description": "One chronograph result: the average muzzle velocity at a temperature.",
      "type": "object",
      "properties": {
        "temperature_c": {
          "description": "The cartridges' (powder's) temperature when they were shot.",
          "type": "number",
          "format": "double"
        },
        "velocity_mps": {
          "description": "The average muzzle velocity.",
          "type": "number",
          "format": "double"
        },
        "shots": {
          "description": "The string it averages, when imported from a chronograph.",
          "anyOf": [
            {
              "$ref": "#/$defs/ShotStats"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "temperature_c",
        "velocity_mps"
      ]
    },
    "ShotStats": {
      "description": "How a string of shots spread.",
      "type": "object",
      "properties": {
        "count": {
          "description": "How many shots the average is of.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "sd_mps": {
          "description": "Standard deviation (of a sample: n − 1), m/s.",
          "type": "number",
          "format": "double"
        },
        "es_mps": {
          "description": "Extreme spread, fastest less slowest, m/s.",
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "count",
        "sd_mps",
        "es_mps"
      ]
    },
    "LoadZero": {
      "description": "Which weather a load's zero was made in.",
      "oneOf": [
        {
          "description": "The rifle's zero weather.",
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "rifle"
            }
          },
          "required": [
            "mode"
          ]
        },
        {
          "description": "The same weather as the shot, so the weather needs no correction.",
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "same_as_shot"
            }
          },
          "required": [
            "mode"
          ]
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "recorded"
            }
          },
          "$ref": "#/$defs/ZeroWeather",
          "required": [
            "mode"
          ]
        }
      ]
    },
    "ZeroWeather": {
      "description": "Weather when a rifle was zeroed.",
      "type": "object",
      "properties": {
        "temperature_c": {
          "description": "Air temperature.",
          "type": "number",
          "format": "double"
        },
        "powder_temperature_c": {
          "description": "The cartridges' (powder's) temperature.",
          "type": "number",
          "format": "double"
        },
        "pressure_hpa": {
          "description": "Air pressure as a barometer there reads it (not reduced to sea level).",
          "type": "number",
          "format": "double"
        },
        "humidity_percent": {
          "description": "Relative humidity.",
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "temperature_c",
        "powder_temperature_c",
        "pressure_hpa",
        "humidity_percent"
      ]
    },
    "Truing": {
      "description": "A long shot that showed where the calculation was off, and the factor\nfound to make it match.",
      "type": "object",
      "properties": {
        "method": {
          "description": "What was adjusted.",
          "$ref": "#/$defs/TruingMethod"
        },
        "range_m": {
          "description": "The range of the shot.",
          "type": "number",
          "format": "double"
        },
        "elevation_mrad": {
          "description": "What it took to hit centre: elevation in mrad, up positive.",
          "type": "number",
          "format": "double"
        },
        "inclination_degrees": {
          "description": "Shot angle then, degrees.",
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "weather": {
          "description": "The weather then.",
          "$ref": "#/$defs/ZeroWeather"
        },
        "factor": {
          "description": "The velocity or drag multiplier that makes the calculation match.",
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "method",
        "range_m",
        "elevation_mrad",
        "inclination_degrees",
        "weather",
        "factor"
      ]
    },
    "TruingMethod": {
      "description": "What truing adjusts to make the calculation match a real shot.",
      "oneOf": [
        {
          "description": "Scale the muzzle velocity: for loads without a chronograph.",
          "type": "string",
          "const": "velocity"
        },
